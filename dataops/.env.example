# Athar DataOps Configuration

# Absolute path to the local Turso database file
DB_PATH=/home/username/.local/share/athar/athar.db

# Registry endpoint URL
REGISTRY_URL=https://startups.smartcapital.tn/?lang=en

# User-Agent for registry HTTP requests: name the bot and how to reach its owner
REGISTRY_USER_AGENT=AtharBot/0.1 (+https://github.com/OussemaJaouadi/Athar)

# Pipeline timeout in seconds
PIPELINE_TIMEOUT_SECONDS=300

# Preferred interface theme at startup: dark or light
THEME=dark

# Legacy single Groq credential (used only when .env.profiles.toml is absent).
# Use a label, never a secret, for the profile; history keeps its marker.
GROQ_API_KEY=
GROQ_PROFILE=personal-free
GROQ_MODEL=qwen/qwen3.8-27b

# Multi-profile Groq rotation. Preferred over the single key above. Create
# dataops/.env.profiles.toml (git-ignored) with one [[profile]] block per key:
#
#   [[profile]]
#   name = "primary"
#   api_key = "gsk_..."
#
#   [[profile]]
#   name = "backup"
#   api_key = "gsk_..."
#   model = "qwen/qwen3.8-27b"
#
# model is optional and falls back to GROQ_MODEL. Keys never leave this file:
# the database registry stores only the name, model, and a key fingerprint.
# Per-profile limits are data, not TOML policy: free-tier defaults are seeded
# into dataops_quotas when a profile is first registered and the operator edits
# those rows directly.
