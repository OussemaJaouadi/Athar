/* Athar DataOps TUI Design System — Foundation v0.1 */

Screen {
    background: $background;
    color: $foreground;
}

/* Masthead Navigation Bar */
#masthead {
    height: 3;
    background: $surface;
    border-bottom: solid $control-line;
    padding: 0 2;
    align-vertical: middle;
}

#wordmark {
    color: $action-fg;
    background: $action-bg;
    text-style: bold;
    padding: 0 1;
    margin-right: 1;
}

#app-name {
    color: $foreground;
    text-style: bold;
    width: auto;
}

#masthead-status {
    color: $muted;
    width: 1fr;
    text-align: right;
}

/* Normal workspace tabs */
/* Tabs & Workspace Frame */
#workspace, ContentSwitcher, TabPane {
    height: 1fr;
}

Tabs {
    background: $surface;
    border-bottom: solid $control-line;
    height: 3;
}

Tab {
    color: $muted;
    padding: 0 2;
    height: 3;
}

Tab.-active {
    color: $link-ink;
    text-style: bold;
    background: $selection;
    border-bottom: tall $link-ink;
}

Tabs:focus Tab.-active {
    background: $selection;
}

TabPane {
    padding: 1 2;
}

#checkpoint-grid {
    height: 1fr;
    min-height: 0;
}

#checkpoint-grid .probe-card {
    width: 1fr;
    height: 1fr;
    min-height: 0;
    margin-bottom: 0;
    margin-right: 1;
    padding: 1 2;
    overflow-y: auto;
}

#run-workspace {
    height: 1fr;
    min-height: 0;
}

#run-operations {
    width: 42%;
    min-width: 42;
    max-width: 56;
    height: 1fr;
    min-height: 0;
    padding: 1 2;
    background: $surface;
    border: round $control-line;
    margin-right: 1;
}

#run-context {
    width: 1fr;
    height: 1fr;
    min-height: 0;
    padding: 1 2;
    background: $surface;
    border: round $control-line;
}

#run-operations:focus-within,
#run-context:focus-within {
    border: round $link-ink;
}

#run-context-header {
    height: 3;
    align-vertical: middle;
    margin-bottom: 1;
}

#run-context-header .heading {
    width: 1fr;
    margin: 0;
}

#run-context-header Button {
    min-width: 14;
    margin-left: 1;
}

#run-primary-actions,
#run-impact-actions {
    height: 3;
    margin-top: 1;
    margin-bottom: 0;
}

#run-primary-actions Button,
#run-impact-actions Button {
    width: 18;
    min-width: 18;
}

#run-impact-actions Button.impact {
    background: $warning;
    color: $background;
    border: round $warning;
    text-style: bold;
}

#run-impact-actions Button.impact:hover {
    background: $warning;
    color: $background;
    text-style: bold;
}

#run-impact-actions Button.impact:disabled,
Screen:light #run-impact-actions Button.impact:disabled {
    background: $panel;
    color: $muted;
    border: round $control-line;
    text-style: none;
}

#run-profiles-summary {
    padding: 0 1;
    border: round $control-line;
    background: $panel;
    height: auto;
}

#run-status {
    width: 1fr;
    height: auto;
    padding: 0;
    border: none;
    background: transparent;
    text-style: bold;
}

#run-status.success { color: $success; }
#run-status.error { color: $error; }
#run-status.warning { color: $warning; }

#run-metrics {
    height: 5;
    margin-bottom: 1;
}

.run-statusbar {
    height: 3;
    margin-top: 1;
    align-vertical: middle;
}

.run-statusbar #run-elapsed {
    width: auto;
    text-align: right;
}

#run-meta {
    height: 1;
}

#run-meta #run-counters {
    width: auto;
    margin-right: 2;
    text-style: bold;
}

#run-log-title {
    margin-top: 1;
    margin-bottom: 1;
}

#recent-runs {
    margin-top: 1;
}

#recent-runs-list {
    height: auto;
    max-height: 10;
    border: round $control-line;
    background: $surface;
}

#recent-runs-list:focus-within {
    border: round $link-ink;
}

/* Split Rails & Dossier Panels */
.split {
    height: 1fr;
}

.rail {
    width: 32;
    background: $surface;
    border: round $control-line;
    padding: 1;
    margin-right: 1;
}

.rail:focus-within {
    border: round $link-ink;
}

.detail {
    width: 1fr;
    height: 1fr;
    background: $surface;
    border: round $control-line;
    padding: 1 2;
}

.detail:focus-within {
    border: round $link-ink;
}

/* Record Listing & Item Highlights */
#records-count {
    padding: 0 1;
    height: 1;
    margin-bottom: 1;
    background: $panel;
    color: $link-ink;
    text-style: bold;
    text-align: center;
}

#records-rail {
    width: 32;
}

#records-list {
    background: transparent;
    border: none;
    height: 1fr;
}

#records-list > ListItem {
    padding: 0 2;
    height: auto;
    margin-bottom: 0;
    border-left: blank transparent;
    color: $foreground;
}

#records-list > ListItem.-hovered {
    background: $block-hover-background;
}

#records-list > ListItem.-highlight {
    background: $selection;
    border-left: solid $control-line;
}

#records-list > ListItem.-highlight Label {
    color: $foreground;
    text-style: bold;
}

#records-list:focus > ListItem.-highlight {
    background: $selection;
    border-left: thick $link-ink;
}

#records-list:focus > ListItem.-highlight Label {
    color: $link-ink;
    text-style: bold;
}

#records-list:focus {
    border: none;
}

/* Dossier Components */
#detail-title-row {
    height: auto;
    align-vertical: middle;
    margin-bottom: 0;
}

#detail-title {
    color: $link-ink;
    text-style: bold;
    width: auto;
    margin-right: 2;
}

#detail-badge {
    width: auto;
    height: auto;
}

#detail-summary {
    color: $muted;
    margin-bottom: 1;
}

#detail-description {
    padding: 1 2;
    background: $panel;
    border: round $line;
    border-left: thick $link-ink;
    margin: 1 0;
}

#detail-normalized {
    padding: 1 2;
    background: $panel;
    border: round $line;
    margin-bottom: 1;
}

#review-section {
    border: round $warning;
    background: $surface;
    padding: 1 2;
    margin: 1 0;
}

#detail-fields {
    padding: 1 2;
    background: $panel;
    border: round $line;
    margin-bottom: 1;
}

#detail-original {
    padding: 1 2;
    background: $panel;
    border: round $line;
}

#prepared-disclosure Static {
    padding: 1 2;
    background: $panel;
    border: round $line;
}

/* Interactive Collapsibles */
Collapsible {
    border: round $control-line;
    background: $panel;
    padding: 0 2;
    margin-top: 2;
}

Collapsible:focus-within {
    border: round $link-ink;
}

Collapsible > Contents {
    padding: 1 1 1 0;
}

CollapsibleTitle {
    color: $foreground;
    text-style: bold;
}

CollapsibleTitle:focus {
    color: $link-ink;
    background: $selection;
}

/* Button & Action Bar Controls: border matches background (seamless); accent only on focus. */
Button {
    min-width: 14;
    height: 3;
    border: round $panel;
    background: $panel;
    color: $foreground;
}

Button:hover {
    background: $block-hover-background;
    border: round $block-hover-background;
    text-style: bold;
}

Button.-primary {
    background: $action-bg;
    color: $action-fg;
    text-style: bold;
    border: round $action-bg;
}

Button.-primary:hover {
    background: $action-hover;
    border: round $action-hover;
}

Button:focus {
    border: round $link-ink;
    text-style: bold;
    background: $selection;
}

/* Focus keeps the action's readable foreground/background pair. */
Button.-primary:focus {
    background: $action-bg;
    color: $action-fg;
    border: round $action-fg;
}
Button.-primary:hover:focus { background: $action-hover; border: round $action-fg; }

Button:disabled {
    opacity: 0.5;
    background: $panel;
    color: $muted;
    border: round $panel;
    text-style: none;
}

.actions {
    height: 3;
    margin: 1 0;
}

.actions Button {
    margin-right: 1;
}

.pager {
    height: 3;
    margin-top: 1;
}

.pager Button {
    min-width: 10;
    width: 10;
    margin-right: 1;
}

/* Database Schema & Tables */
#results-label {
    height: 1;
    margin-bottom: 1;
    text-style: bold;
    color: $link-ink;
}

#schema-tree {
    background: transparent;
    border: none;
    height: 1fr;
}

#schema-tree:focus {
    border: none;
}

#results-table {
    height: 1fr;
    background: $surface;
    border: round $control-line;
}

#results-table > .datatable--header {
    background: $panel;
    color: $link-ink;
    text-style: bold;
    border-bottom: solid $control-line;
}

#results-table > .datatable--cursor {
    background: $selection;
    color: $foreground;
    text-style: bold;
}

#results-table:focus {
    border: round $link-ink;
}

#db-rail {
    width: 22;
}

#db-detail {
    width: 1fr;
    height: 1fr;
}

#results-table {
    width: 1fr;
    height: 1fr;
    background: $surface;
    border: round $control-line;
}

#db-drawer {
    width: 36%;
    min-width: 32;
    max-width: 60;
    background: $surface;
    border: round $control-line;
    padding: 1;
    margin-left: 1;
}

#db-drawer:focus-within {
    border: round $link-ink;
}

#db-toolbar {
    height: 3;
    margin-bottom: 1;
}

#db-toolbar #db-migrations-summary {
    margin-left: 2;
    margin-right: 2;
    width: 1fr;
}

#db-toolbar #db-wipe {
    width: 14;
    min-width: 14;
}

#db-migrations {
    margin-top: 0;
    margin-bottom: 1;
}

#db-migrations-table {
    padding: 1;
    background: $panel;
    border: round $line;
}

/* Checkpoints */
#checkpoint-header {
    background: $surface;
    border: round $control-line;
    padding: 1 2;
    margin-bottom: 1;
    height: auto;
    align-vertical: middle;
}

#checkpoint-header-title {
    width: 1fr;
    height: auto;
}

#checkpoint-header-title .heading {
    margin-bottom: 1;
}

#checkpoint-header .chip {
    margin-right: 2;
}

#checkpoint-header #checkpoint-cancel {
    width: 12;
    min-width: 12;
}

.probe-card {
    background: $surface;
    border: round $control-line;
    padding: 1 2;
    margin-bottom: 1;
}

#checkpoint-registry {
    border-left: thick $link-ink;
}

#checkpoint-prepare-card {
    border-left: thick $success;
}

.probe-card.-busy {
    border: round $warning;
    border-left: thick $warning;
}

.probe-card:focus-within {
    border: round $link-ink;
    border-left: thick $link-ink;
}

.card-head {
    height: auto;
    align-vertical: middle;
    margin-bottom: 1;
}

.card-head .section-label {
    width: 1fr;
    margin: 0;
}

.chip {
    background: $panel;
    border: round $line;
    color: $muted;
    padding: 0 2;
    width: auto;
}

.chip.success { color: $success; border: round $success; }
.chip.error { color: $error; border: round $error; }
.chip.warning { color: $warning; border: round $warning; }

#checkpoint-status { width: auto; }

.probe-actions {
    height: 3;
    margin: 1 0;
}

.probe-actions Button {
    margin-left: 1;
}

#checkpoint-row {
    width: 14;
    margin-right: 0;
}

#checkpoint-profile-pick {
    margin-top: 0;
    height: auto;
}

#checkpoint-profile-pick Input {
    margin-bottom: 1;
}

#checkpoint-profile {
    width: 100%;
}

#checkpoint-desc {
    height: 4;
    background: $panel;
    border: round $control-line;
    color: $foreground;
    margin-top: 1;
}

#checkpoint-desc:focus {
    border: round $link-ink;
}

#checkpoint-registry-result-header,
#checkpoint-prepare-result-header {
    height: 2;
    margin-top: 1;
    align-vertical: middle;
}

#checkpoint-registry-result-header .section-label,
#checkpoint-prepare-result-header .section-label {
    width: auto;
    margin-right: 1;
}

#checkpoint-registry-result-header .muted,
#checkpoint-prepare-result-header .muted {
    width: 1fr;
    text-align: right;
}

#checkpoint-registry-clear,
#checkpoint-prepare-clear {
    min-width: 12;
    width: 12;
}

#checkpoint-registry-result,
#checkpoint-prepare-result {
    height: auto;
    min-height: 8;
    max-height: 20;
    background: $panel;
    border: round $line;
    padding: 0 1;
    margin-top: 0;
    overflow-y: auto;
}

#prepare-preview {
    height: auto;
    margin-top: 1;
    margin-bottom: 0;
    padding: 1;
    border: round $warning;
    background: $panel;
}

#prepare-preview #prepare-preview-body {
    height: auto;
    margin: 0;
}

#prepare-preview .actions {
    margin: 1 0 0 0;
    align-horizontal: right;
}

#logs-split {
    height: 1fr;
}

#logs-rail {
    width: 28;
    background: $surface;
    border: round $control-line;
    padding: 1;
    margin-right: 1;
    height: 1fr;
}

#logs-rail:focus-within {
    border: round $link-ink;
}

#logs-rail-title {
    text-style: bold;
    color: $link-ink;
    margin-bottom: 0;
}

#logs-rail-subtitle {
    color: $muted;
    margin-bottom: 1;
}

.rail-section {
    color: $muted;
    text-style: bold;
    margin-top: 1;
    margin-bottom: 0;
    padding: 0 1;
}

#logs-rail Button {
    width: 100%;
    min-width: 100%;
    height: 2;
    margin-bottom: 0;
    border: none;
    background: transparent;
    color: $muted;
    text-align: left;
    padding: 0 1;
}

#logs-rail Button:hover {
    background: $block-hover-background;
    color: $link-ink;
    text-style: bold;
}

#logs-rail Button:focus {
    background: $selection;
    color: $link-ink;
    text-style: bold;
}

#logs-rail Button.-active {
    background: $selection;
    color: $link-ink;
    text-style: bold;
    border-left: thick $link-ink;
}

#logs-stream {
    width: 1fr;
    height: 1fr;
}

#logs-search {
    height: 3;
    border: round $control-line;
    background: $panel;
    padding: 0 1;
    margin-bottom: 1;
}

#logs-search:focus {
    border: round $link-ink;
}

#logs-empty {
    display: none;
    padding: 1 2;
    background: $panel;
    border: round $line;
    margin-bottom: 1;
}

#logs-console {
    height: 1fr;
    background: $surface;
    border: round $control-line;
    padding: 1;
}

#logs-console:focus {
    border: round $link-ink;
}

/* History */
#history-header {
    height: auto;
    min-height: 4;
    margin-bottom: 1;
    padding: 1 2;
    background: $surface;
    border: round $control-line;
    align-vertical: middle;
}

#history-header #history-refresh {
    min-width: 12;
    width: 12;
}

#history-toolbar {
    height: 3;
    margin-bottom: 1;
}

#history-search {
    width: 1fr;
    height: 3;
    background: $surface;
    border: round $control-line;
}

#history-title {
    width: 1fr;
    height: auto;
}

#history-status {
    width: auto;
}

#history-body {
    height: 1fr;
    min-height: 0;
}

#history-rail {
    width: 40;
    min-height: 0;
    height: 1fr;
    background: $surface;
    border: round $control-line;
    padding: 1;
    margin-right: 1;
}

#history-list {
    height: 1fr;
    background: transparent;
    border: none;
}

#history-list > ListItem {
    height: auto;
    min-height: 3;
    padding: 0 1;
    border-bottom: solid $line;
    color: $foreground;
}

#history-list > ListItem > Label {
    width: 1fr;
    height: 1;
}

#history-list .history-item-title {
    text-style: bold;
}

#history-list .history-item-meta {
    color: $muted;
}

#history-list > ListItem.history-completed {
    border-left: thick $success;
}

#history-list > ListItem.history-failed,
#history-list > ListItem.history-error {
    border-left: thick $error;
}

#history-list > ListItem.history-cancelled {
    border-left: thick $warning;
}

#history-list > ListItem.history-running {
    border-left: thick $link-ink;
}

#history-list > ListItem.-hovered {
    background: $block-hover-background;
}

#history-list > ListItem.-highlight {
    background: $selection;
    border-left: thick $link-ink;
}

#history-list > ListItem.-highlight > Label {
    color: $link-ink;
}

#history-list:focus > ListItem.-highlight > Label {
    text-style: bold;
}

#history-detail {
    width: 1fr;
    min-height: 0;
    height: 1fr;
    background: $surface;
    border: round $control-line;
    padding: 1 2;
}

#history-detail-head {
    width: 100%;
    height: auto;
    margin-bottom: 1;
    align-vertical: middle;
}

#history-detail-title {
    width: 1fr;
    margin: 0;
}

#history-detail-body {
    background: transparent;
    color: $foreground;
    padding: 0;
}

/* Records Search */
#records-search {
    height: 3;
    border: round $control-line;
    background: $panel;
    padding: 0 1;
    margin-bottom: 1;
}

#records-search:focus {
    border: round $link-ink;
}

/* Settings Split View */
#settings-split {
    height: 1fr;
}

#settings-config-card {
    width: 2fr;
    height: 1fr;
    background: $surface;
    border: round $control-line;
    padding: 1 2;
    margin-right: 1;
}

#settings-config-card:focus-within {
    border: round $link-ink;
}

#settings-about-card {
    width: 1fr;
    height: 1fr;
    background: $surface;
    border: round $control-line;
    padding: 1 2;
}

#settings-about-card:focus-within {
    border: round $link-ink;
}

#settings-env-heading {
    margin-top: 1;
}

#settings-env-table {
    margin-top: 0;
    margin-bottom: 1;
}

#settings-usage,
#settings-limits {
    height: auto;
    max-height: 24;
    min-height: 5;
    padding: 0 1;
    background: $panel;
    border: round $line;
    color: $foreground;
}

#settings-usage > .datatable--header,
#settings-limits > .datatable--header {
    background: $surface;
    color: $link-ink;
    text-style: bold;
}

#settings-usage:focus,
#settings-limits:focus {
    border: double $link-ink;
}

#settings-arch-table {
    margin-top: 1;
    margin-bottom: 1;
}

#theme-picker {
    width: 100%;
    margin-bottom: 1;
}

SelectCurrent {
    border: round $control-line;
    background: $panel;
}

Select:focus SelectCurrent {
    border: round $link-ink;
}

/* Dialogs */
HelpScreen, AboutScreen, WipeConfirmScreen {
    align: center middle;
    background: $background 80%;
}

#wipe-dialog {
    width: 72;
    height: auto;
    max-height: 95%;
    padding: 1 2;
    background: $surface;
    border: round $error;
}

#wipe-warning {
    margin-bottom: 1;
}

#wipe-actions {
    height: 3;
}

#wipe-actions Button {
    width: 1fr;
    margin-right: 1;
}

#help-dialog {
    width: 74;
    height: auto;
    max-height: 95%;
    padding: 1 2;
    background: $surface;
    border: round $link-ink;
}

#help-title {
    text-align: center;
    color: $link-ink;
    text-style: bold;
    margin-bottom: 1;
}

#help-table {
    margin-bottom: 1;
}

#close-help {
    width: 100%;
}

#about-dialog {
    width: auto;
    min-width: 50;
    max-width: 100%;
    height: auto;
    max-height: 95%;
    padding: 1 2;
    background: $surface;
    border: round $link-ink;
}

#ascii-mark {
    width: 101;
    height: auto;
}

/* Global Typography & Feedback */
Static, Label {
    height: auto;
}

.heading {
    text-style: bold;
    margin-bottom: 1;
    color: $foreground;
}

.muted { color: $muted; }
.success { color: $success; }
.warning { color: $warning; }
.error { color: $error; }
.field-label { text-style: bold; margin-bottom: 1; color: $foreground; }
.section-label { text-style: bold; margin-top: 1; }
.note { margin-top: 1; }
.description { margin: 1 0; }
#records-empty { height: auto; padding: 2 1; }

/* Responsive Adaptation */
.compact TabPane { padding: 0 1; }
.compact .heading { margin-bottom: 0; }
.compact .rail { width: 25; margin-right: 1; }
.compact #run-workspace { layout: vertical; height: auto; }
.compact #run-operations,
.compact #run-context { width: 1fr; min-width: 0; max-width: 100%; height: auto; min-height: 18; margin-right: 0; margin-bottom: 1; }
.compact #run-context { min-height: 20; }
.compact #run-metrics { display: none; }
.compact #checkpoint-registry-output,
.compact #checkpoint-prepare-output { height: auto; max-height: 100%; }
.compact #checkpoint-grid { layout: vertical; height: auto; }
.compact #checkpoint-grid .probe-card { width: 1fr; height: auto; min-height: 22; margin-right: 0; margin-bottom: 1; }
.compact #history-rail { width: 34; }
.compact #masthead { height: 1; padding: 0 1; }
.compact #settings-config-card { width: 1fr; margin-right: 0; }
.compact #settings-about-card { display: none; }
.compact #db-rail { width: 16; margin-right: 1; }
.compact #db-drawer { width: 36; min-width: 30; padding: 0 1; margin-left: 1; }

/* Below 120 columns, row details replace the grid until Back/Escape. */
DatabasePane.narrow #db-drawer { display: none; }
DatabasePane.narrow.inspecting #db-rail,
DatabasePane.narrow.inspecting #db-detail { display: none; }
DatabasePane.narrow.inspecting #db-drawer {
    display: block; width: 1fr; min-width: 0; max-width: 100%; margin: 0;
}
#drawer-back { display: none; margin-bottom: 1; }
DatabasePane.narrow #drawer-back { display: block; }
#inspect-row { display: none; width: auto; margin-top: 1; }
DatabasePane.narrow #inspect-row { display: block; }
#records-no-match { padding: 1 2; width: 1fr; }
#clear-record-search { margin-top: 1; }

Input > .input--placeholder { color: $muted; }

/* Light mode: opaque surfaces and explicit states across every workspace. */
Screen:light TabPane { background: $background; }
Screen:light Tab { background: $surface; color: #46535A; text-style: none; }
Screen:light Tab:hover { background: $block-hover-background; color: $link-ink; }
Screen:light Tab.-active {
    background: $action-bg; color: $action-fg;
    border-bottom: tall $link-ink; text-style: bold;
}
Screen:light Tab.-active:hover { background: $action-hover; }
Screen:light Tabs:focus Tab.-active { text-style: bold underline; }
Screen:light Underline > .underline--bar { color: $link-ink; background: $line; }

/* Prevent framework focus/pressed tints from changing the specified colors. */
Screen:light Button, Screen:light Input, Screen:light SelectCurrent,
Screen:light SelectOverlay, Screen:light DataTable, Screen:light Tree,
Screen:light Collapsible, Screen:light OptionList, Screen:light TextArea {
    background-tint: transparent; tint: transparent;
}
Screen:light Button { background: $surface; border: round $surface; color: $foreground; }
Screen:light Button:hover {
    background: $block-hover-background; border: round $block-hover-background;
    color: $link-ink; text-style: bold;
}
Screen:light Button:focus { border: round $link-ink; }
Screen:light Button.-primary { background: $action-bg; border: round $action-bg; color: $action-fg; }
Screen:light Button.-primary:hover,
Screen:light Button.-primary.-active { background: $action-hover; border: round $action-hover; color: $action-fg; }
Screen:light Button.-primary:focus { border: round $action-fg; }
Screen:light Button:disabled {
    background: $panel; color: $muted; border: round $panel;
    opacity: 1; text-opacity: 1; text-style: italic;
}

/* Records: hover is temporary; the selected record keeps a stronger fill. */
Screen:light #records-list > ListItem.-hovered { background: $block-hover-background; }
Screen:light #records-list > ListItem.-highlight { background: $selection; border-left: thick $link-ink; }
Screen:light #records-list > ListItem.-highlight Label { color: $link-ink; }
Screen:light #records-list:focus > ListItem.-highlight Label { text-style: bold underline; }
Screen:light CollapsibleTitle:hover { background: $block-hover-background; color: $link-ink; }
Screen:light CollapsibleTitle:focus { background: $selection; color: $link-ink; text-style: bold underline; }
Screen:light #records-search, Screen:light #logs-search, Screen:light #history-search {
    background: $surface; color: $foreground;
}
Screen:light #records-search:focus, Screen:light #logs-search:focus,
Screen:light #history-search:focus { border: double $link-ink; }
Screen:light #history-header, Screen:light #history-rail, Screen:light #history-detail {
    background: $surface; color: $foreground;
}
Screen:light #history-detail-body { background: transparent; color: $foreground; }
Screen:light #history-list > ListItem { background: $surface; color: $foreground; }
Screen:light #history-list > ListItem.-hovered { background: $block-hover-background; }
Screen:light #history-list > ListItem.-highlight { background: $selection; color: $link-ink; }
Screen:light #history-status { background: $panel; color: $foreground; }
Screen:light #history-status.success { color: $success; }
Screen:light #history-status.warning { color: $warning; }
Screen:light #history-status.error { color: $error; }
Screen:light #checkpoint-desc { background: $surface; color: $foreground; }
Screen:light #checkpoint-desc:focus { border: double $link-ink; }
Screen:light #checkpoint-header, Screen:light .probe-card {
    background: $surface; color: $foreground; border: round $control-line;
}
Screen:light #checkpoint-registry-output, Screen:light #checkpoint-prepare-output {
    background: $panel;
}
Screen:light .chip { background: $panel; color: $muted; border: round $control-line; }

/* Database: explicit zebra, hover, cursor and schema-tree colors. */
Screen:light #results-table > .datatable--odd-row { background: $surface; color: $foreground; }
Screen:light #results-table > .datatable--even-row { background: $panel; color: $foreground; }
Screen:light #results-table > .datatable--header { background: $panel; color: $foreground; background-tint: transparent; }
Screen:light #results-table > .datatable--hover,
Screen:light #results-table > .datatable--header-hover { background: $block-hover-background; color: $foreground; }
Screen:light #results-table > .datatable--cursor { background: $selection; color: $link-ink; }
Screen:light #results-table:focus > .datatable--cursor { text-style: bold underline; }
Screen:light #schema-tree > .tree--guides,
Screen:light #schema-tree > .tree--guides-hover,
Screen:light #schema-tree > .tree--guides-selected { color: $control-line; }
Screen:light #schema-tree > .tree--cursor { background: $selection; color: $link-ink; text-style: bold; }
Screen:light #schema-tree:focus > .tree--cursor { text-style: bold underline; }

/* Logs: the active filter remains distinct from the hovered filter. */
Screen:light #logs-rail { background: $surface; color: $foreground; }
Screen:light #logs-stream { background: $background; }
Screen:light #logs-console { background: $surface; color: $foreground; }
Screen:light #logs-console:focus { border: double $link-ink; }
Screen:light #logs-empty { background: $panel; color: $muted; }
Screen:light #logs-rail Button { background: $surface; color: $foreground; border: none; text-style: none; }
Screen:light #logs-rail Button:hover { background: $selection; color: $link-ink; text-style: bold; border: none; }
Screen:light #logs-rail Button.-active { background: $action-bg; color: $action-fg; border-left: thick $link-ink; text-style: bold; }
Screen:light #logs-rail Button.-active:hover { background: $action-hover; color: $action-fg; text-style: bold; }
Screen:light #logs-rail Button:focus { background: $selection; color: $link-ink; text-style: bold; border: none; border-left: thick $link-ink; }
Screen:light #logs-rail Button.-active:focus { background: $action-bg; color: $action-fg; text-style: bold; }

Screen:light #run-impact-actions Button.impact { background: $warning; color: $background; border: round $warning; }
Screen:light #run-impact-actions Button.impact:hover { background: $warning; color: $background; }
Screen:light #run-impact-actions Button.impact:disabled { background: $panel; color: $muted; border: round $control-line; text-style: none; }

Screen:light SelectCurrent { background: $surface; color: $foreground; }
Screen:light SelectCurrent:hover { background: $block-hover-background; }
Screen:light Select:focus SelectCurrent { border: double $link-ink; }
Screen:light SelectOverlay { background: $surface; color: $foreground; border: round $link-ink; }
Screen:light SelectOverlay > .option-list--option-hover { background: $block-hover-background; color: $foreground; }
Screen:light SelectOverlay > .option-list--option-highlighted { background: $selection; color: $link-ink; text-style: bold; }

/* Evidence has one frame for metadata and a separate quiet JSON reading surface. */
Screen:light #source-disclosure { background: $surface; }
Screen:light #detail-fields {
    background: $surface; color: $foreground; border: none; padding: 0;
}
Screen:light #detail-original { background: $panel; color: $foreground; }
