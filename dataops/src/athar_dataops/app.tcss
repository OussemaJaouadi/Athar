/* Athar DataOps terminal stylesheet.
   One frame per column at most. Regions separate by whitespace, a section
   label, or a single rule; never a box inside a box. Every color is a theme
   token from themes.py. */

Screen {
    background: $background;
    color: $foreground;
}

/* ---------- chrome: masthead, tabs, footer ---------- */

#masthead {
    height: 1;
    padding: 0 1;
    background: $surface;
}

#wordmark {
    color: $action-fg;
    background: $action-bg;
    text-style: bold;
    padding: 0 1;
    margin-right: 1;
}

#app-name {
    color: $foreground;
    text-style: bold;
    width: auto;
}

#masthead-status {
    color: $muted;
    width: 1fr;
    text-align: right;
}

#masthead-status.success { color: $success; }
#masthead-status.warning { color: $warning; }
#masthead-status.error { color: $error; }

#workspace, ContentSwitcher, TabPane {
    height: 1fr;
}

Tabs {
    height: 2;
    background: $surface;
}

Tab {
    color: $muted;
    padding: 0 1;
}

Tab:hover { color: $foreground; }

Tab.-active {
    color: $link-ink;
    text-style: bold;
}

Tabs:focus Tab.-active {
    color: $link-ink;
    background: transparent;
    text-style: bold underline;
}

Underline > .underline--bar {
    color: $link-ink;
    background: $line;
}

TabPane {
    padding: 1 1 0 1;
    background: $surface;
}

Footer {
    background: $surface;
}

/* ---------- text roles ---------- */

Static, Label { height: auto; }

.heading {
    text-style: bold;
    color: $foreground;
    margin-bottom: 1;
}

.section-label {
    text-style: bold;
    color: $muted;
    margin-top: 1;
}

.section-label.first { margin-top: 0; }

.muted { color: $muted; }
.success { color: $success; }
.warning { color: $warning; }
.error { color: $error; }
.note { margin-top: 1; }
.description { margin-bottom: 1; }

/* One status chip: text on a tint, one row, no border. */
.chip {
    width: auto;
    height: 1;
    padding: 0 1;
    background: $panel;
    color: $muted;
}

.chip.success { background: $success-bg; color: $success; }
.chip.warning { background: $warning-bg; color: $warning; }
.chip.error { background: $error-bg; color: $error; }

/* ---------- controls ---------- */

/* Buttons are one row: [ label ]. No 3D edges, no box around a box. */
Button {
    width: auto;
    min-width: 0;
    height: 1;
    border: none;
    padding: 0 2;
    background: $panel;
    color: $foreground;
    text-style: bold;
}

Button:hover {
    background: $block-hover-background;
    color: $foreground;
}

Button:focus {
    background: $selection;
    color: $link-ink;
    text-style: bold underline;
}

Button.-primary {
    background: $action-bg;
    color: $action-fg;
}

Button.-primary:hover { background: $action-hover; color: $action-fg; }

Button.-primary:focus {
    background: $action-bg;
    color: $action-fg;
    text-style: bold underline;
}

/* Spends provider quota: information text on its tint. */
Button.impact {
    background: $info-bg;
    color: $info-ink;
}

Button.impact:hover { background: $info-bg; color: $info-ink; text-style: bold underline; }
Button.impact:focus { background: $info-bg; color: $info-ink; text-style: bold underline; }

/* Destroys data: error text on its tint; filled only while focused. */
#run-reset, #db-wipe, #wipe-confirm {
    background: $error-bg;
    color: $destructive-bg;
}

#run-reset:hover, #db-wipe:hover, #wipe-confirm:hover {
    background: $destructive-bg;
    color: $destructive-fg;
}

#run-reset:focus, #db-wipe:focus, #wipe-confirm:focus {
    background: $destructive-bg;
    color: $destructive-fg;
    text-style: bold underline;
}

Button:disabled {
    background: $panel;
    color: $muted;
    text-style: italic;
    opacity: 1;
    text-opacity: 1;
}

.actions {
    height: 1;
    margin-top: 1;
}

.actions Button { margin-right: 1; }

Input {
    height: 1;
    border: none;
    padding: 0 1;
    background: $panel;
    color: $foreground;
}

Input:focus {
    background: $selection;
    color: $foreground;
}

Input > .input--placeholder { color: $muted; }

SelectCurrent {
    height: 1;
    border: none;
    padding: 0 1;
    background: $panel;
    color: $foreground;
}

Select:focus > SelectCurrent { background: $selection; }
SelectCurrent > .select-current--placeholder { color: $muted; }

SelectOverlay {
    background: $surface;
    color: $foreground;
    border: round $line;
}

SelectOverlay > .option-list--option-hover { background: $block-hover-background; }
SelectOverlay > .option-list--option-highlighted { background: $selection; color: $link-ink; text-style: bold; }

TextArea {
    border: none;
    background: $panel;
    color: $foreground;
}

TextArea:focus { border-left: thick $link-ink; }

Collapsible {
    border: none;
    background: transparent;
    padding: 0;
    margin-top: 1;
}

Collapsible > Contents { padding: 1 0 0 2; }

CollapsibleTitle {
    padding: 0;
    color: $link-ink;
    text-style: bold;
}

CollapsibleTitle:hover { background: $block-hover-background; }
CollapsibleTitle:focus { background: $selection; color: $link-ink; text-style: bold underline; }

ListView { background: transparent; }

ListView > ListItem {
    height: auto;
    padding: 0 1;
    color: $foreground;
    background: transparent;
}

ListView > ListItem.-hovered { background: $block-hover-background; }

ListView > ListItem.-highlight {
    background: $selection;
    color: $link-ink;
    text-style: bold;
}

ListView > ListItem.-highlight Label { color: $link-ink; }

ListView:focus { background-tint: transparent; }

ListView:focus > ListItem.-highlight {
    border-left: thick $link-ink;
    padding-left: 0;
}

DataTable { background: transparent; }
/* Header in the link color on the panel tint; alternate rows carry a faint tint so rows read apart. */
DataTable > .datatable--header { background: $panel; color: $link-ink; text-style: bold; }
DataTable > .datatable--even-row { background: transparent; }
DataTable > .datatable--odd-row { background: $panel 55%; }
DataTable > .datatable--cursor { background: $selection; color: $link-ink; text-style: bold; }
DataTable:focus { background-tint: transparent; }
DataTable:focus > .datatable--cursor { text-style: bold underline; }
DataTable:focus > .datatable--header { background-tint: transparent; }
DataTable > .datatable--hover { background: $block-hover-background; }

Tree { background: transparent; }
Tree > .tree--guides, Tree > .tree--guides-hover, Tree > .tree--guides-selected { color: $line; }
Tree > .tree--cursor { background: $selection; color: $link-ink; text-style: bold; }
Tree > .tree--highlight-line { background: $block-hover-background; }
Tree:focus { background-tint: transparent; }
Tree:focus > .tree--cursor { text-style: bold underline; }

RichLog { background: transparent; }
RichLog:focus { background-tint: transparent; }

VerticalScroll, ListView, DataTable, RichLog, Tree, TextArea {
    scrollbar-size: 1 1;
}

/* ---------- layout primitives ---------- */

.split { height: 1fr; }

.rail {
    width: 36;
    height: 1fr;
    margin-right: 2;
}

.detail {
    width: 1fr;
    height: 1fr;
    border-left: solid $line;
    padding-left: 2;
}

.pager { height: 1; margin-top: 1; }
.pager Button { margin-right: 1; }

/* ---------- Pipeline: operations, runs list, live run ---------- */

#run-workspace { height: 1fr; }

#run-operations {
    width: 42;
    height: 1fr;
    margin-right: 2;
}
#history-search { margin: 1 0; }
#history-list { height: 1fr; min-height: 3; }

#run-operations Button {
    width: 100%;
    text-align: left;
    padding: 0 1;
}

#run-context {
    width: 1fr;
    height: 1fr;
    border-left: solid $line;
    padding-left: 2;
}

#run-context-header { height: 1; margin-bottom: 1; }
#run-context-header .heading { width: 1fr; margin: 0; }
#run-context-header Button { margin-left: 1; }

.run-statusbar { height: auto; }
#run-status { width: 1fr; text-style: bold; }
#run-status.success { color: $success; }
#run-status.error { color: $error; }
#run-status.warning { color: $warning; }
#run-elapsed { width: auto; }
#run-resources { height: auto; }

RunTimeline {
    height: 5;
    margin: 1 0;
    padding: 0;
    border: none;
    background: transparent;
}

RunTimeline:focus { background: $panel; border: none; }

#run-activity { height: 1fr; min-height: 6; }
#run-activity LogsPane { height: 1fr; }

/* ---------- Review ---------- */

#records-rail { width: 38; }
#records-search { margin-bottom: 1; }
#records-count-row { height: 1; margin-bottom: 1; }
#records-review-filter { margin-right: 1; }
#records-review-filter.in-review { background: $selection; color: $link-ink; }
#records-review-filter.in-review:focus { text-style: bold underline; }
#records-count { width: 1fr; color: $muted; text-align: right; }
#records-list { height: 1fr; }

#detail-title-row { height: auto; }
#detail-title { width: auto; margin: 0 2 0 0; color: $link-ink; text-style: bold; }
#detail-badge { width: auto; }
#detail-summary { margin-bottom: 1; }
#review-section { height: auto; margin-bottom: 1; }
#detail-secondary { margin-bottom: 1; }
#detail-normalized { margin-top: 1; margin-bottom: 1; }
#detail-fields { margin-bottom: 1; }
#detail-original { padding: 0 1; background: $panel; }
#records-empty { height: auto; padding: 1 0; }
#records-no-match { width: 1fr; padding: 1 2; }
#clear-record-search { margin-top: 1; }

/* ---------- Data ---------- */

#db-toolbar { height: 1; margin-bottom: 1; }
#db-toolbar #db-migrations-summary { width: 1fr; margin: 0 2; }
#db-migrations { margin: 0 0 1 0; }
#db-rail { width: 28; margin-right: 2; }
#db-detail { width: 1fr; height: 1fr; border-left: solid $line; padding-left: 2; }
#results-label { height: 1; margin-bottom: 1; color: $link-ink; text-style: bold; }
#results-table { height: 1fr; }
#schema-tree { height: 1fr; overflow-x: hidden; }
#db-drawer {
    width: 40;
    border-left: solid $line;
    padding-left: 2;
    margin-left: 2;
}
#drawer-back { display: none; margin-bottom: 1; }
#inspect-row { display: none; margin-top: 1; }
DatabasePane.narrow #db-drawer { display: none; }
DatabasePane.narrow.inspecting #db-rail,
DatabasePane.narrow.inspecting #db-detail { display: none; }
DatabasePane.narrow.inspecting #db-drawer {
    display: block; width: 1fr; border-left: none; padding-left: 0; margin-left: 0;
}
DatabasePane.narrow #drawer-back { display: block; }
DatabasePane.narrow #inspect-row { display: block; }

/* ---------- Pipeline: runs list ---------- */

#history-list > ListItem { min-height: 2; padding: 0 1; }
#history-list > ListItem > Label { width: 1fr; height: 1; }
#history-list .history-item-title { text-style: bold; }
#history-list .history-item-meta { color: $muted; }
#history-list > ListItem.history-completed { border-left: thick $success; padding-left: 0; }
#history-list > ListItem.history-failed { border-left: thick $error; padding-left: 0; }
#history-list > ListItem.history-cancelled { border-left: thick $warning; padding-left: 0; }
#history-list > ListItem.history-running { border-left: thick $link-ink; padding-left: 0; }

/* ---------- Tools ---------- */

#tools-menu { width: 14; height: 1fr; margin-right: 2; }
#tools-view { width: 1fr; height: 1fr; border-left: solid $line; padding-left: 2; }
#tools-view > * { height: 1fr; }

/* ---------- Logs (embedded in Pipeline) ---------- */

#logs-rail { height: 1; margin-bottom: 1; }
#logs-rail Button {
    width: auto;
    height: 1;
    padding: 0 1;
    margin-right: 1;
    background: transparent;
    color: $foreground;
    text-style: none;
}
#logs-rail Button:hover { background: $block-hover-background; }
#logs-rail Button:focus { background: $selection; color: $link-ink; text-style: underline; }
#logs-rail Button.-active { background: $selection; color: $link-ink; text-style: bold; }
#logs-stream { width: 1fr; height: 1fr; }
#logs-search { width: 1fr; margin-right: 1; }
#logs-empty { display: none; padding: 0 1; color: $muted; margin-bottom: 1; }
#logs-title { height: 1; color: $muted; margin-bottom: 0; }
#logs-console { height: 1fr; overflow-x: hidden; }

/* ---------- Probes ---------- */

#checkpoint-header { height: auto; margin-bottom: 1; }
#checkpoint-header-title { width: 1fr; height: auto; }
#checkpoint-header .chip { margin-right: 1; }
#checkpoint-grid { height: 1fr; }
#checkpoint-grid .probe-card { width: 1fr; height: 1fr; }
#checkpoint-registry { margin-right: 2; }
#checkpoint-prepare-card { border-left: solid $line; padding-left: 2; }
.card-head { height: auto; margin-bottom: 1; }
.card-head .section-label { width: 1fr; margin: 0; }
.probe-actions { height: 1; margin: 1 0; }
.probe-actions Button { margin-right: 1; }
#checkpoint-row { width: 8; margin-right: 1; }
#checkpoint-profile-pick { height: auto; margin-top: 1; }
#checkpoint-profile { width: 100%; }
#checkpoint-desc { height: 4; margin-top: 1; }
#checkpoint-registry-result-header, #checkpoint-prepare-result-header { height: 1; margin-top: 1; }
#checkpoint-registry-result-header .section-label, #checkpoint-prepare-result-header .section-label { width: auto; margin: 0 1 0 0; }
#checkpoint-registry-result-header .muted, #checkpoint-prepare-result-header .muted { width: 1fr; text-align: right; }
#checkpoint-registry-result, #checkpoint-prepare-result { height: 1fr; min-height: 6; }
#checkpoint-status { width: auto; }

/* ---------- Settings ---------- */

#settings-env-heading { margin-top: 1; }
#settings-env-table { margin-bottom: 1; }
#settings-usage, #settings-limits { height: auto; margin-bottom: 1; max-width: 90; }
#theme-picker { width: 100%; margin-bottom: 1; }

/* ---------- dialogs ---------- */

HelpScreen, AboutScreen, WipeConfirmScreen, PrepareConfirmScreen {
    align: center middle;
    background: $background 60%;
}

#wipe-dialog, #help-dialog, #about-dialog, #prepare-preview {
    width: 76;
    height: auto;
    max-height: 90%;
    padding: 1 2;
    background: $surface;
    border: round $line;
}

#wipe-dialog { border: round $destructive-bg; }
#prepare-preview { border: round $info-ink; }
#wipe-warning { margin-bottom: 1; }
#wipe-actions, #prepare-actions { height: 1; margin-top: 1; }
#wipe-actions Button, #prepare-actions Button { margin-right: 1; }
#help-title { color: $foreground; }
#help-table { margin-bottom: 1; }
#help-operations { margin-bottom: 1; }
#close-help { margin-top: 0; }
#about-dialog { width: auto; min-width: 50; max-width: 100%; }
#ascii-mark { width: 101; height: auto; }
#mark-hint { margin-top: 1; }

/* ---------- compact (under 100 columns) ---------- */

.compact TabPane { padding: 0 1; }
.compact .rail { width: 26; margin-right: 1; }
.compact .detail { padding-left: 1; }
/* Under 100 columns the operations become one row of buttons and the run takes the rest. */
.compact #run-workspace { layout: vertical; height: 1fr; }
.compact #run-operations { layout: horizontal; width: 1fr; height: 1; margin-right: 0; margin-bottom: 1; }
.compact #run-operations Button { width: auto; margin-right: 1; padding: 0 1; }
.compact #run-operations .section-label, .compact #stat-entities-val, .compact #stat-status-val,
.compact #run-profiles-summary, .compact #history-search, .compact #history-list { display: none; }
.compact #run-context { width: 1fr; height: 1fr; border-left: none; padding-left: 0; }
.compact #run-context-header Button { display: none; }
.compact #run-activity { min-height: 4; }
.compact RunTimeline { margin: 0; }
.compact #records-rail { width: 30; }
.compact #tools-menu { width: 10; margin-right: 1; }
.compact #checkpoint-grid { layout: vertical; height: auto; }
.compact #checkpoint-grid .probe-card { width: 1fr; height: auto; min-height: 14; margin-right: 0; margin-bottom: 1; }
.compact #checkpoint-prepare-card { border-left: none; padding-left: 0; }
.compact #db-rail { width: 16; margin-right: 1; }
.compact #db-drawer { width: 36; margin-left: 1; }

/* ---------- light: defeat framework tints only ---------- */

Screen:light Button, Screen:light Input, Screen:light SelectCurrent, Screen:light SelectOverlay,
Screen:light DataTable, Screen:light Tree, Screen:light Collapsible, Screen:light OptionList,
Screen:light TextArea, Screen:light ListView, Screen:light RichLog {
    background-tint: transparent;
    tint: transparent;
}
